# --- Your business ---
BUSINESS_NAME="Sam's Plumbing"
TRADIE_NAME=Sam
TRADE=plumber
TIMEZONE=Australia/Sydney
SERVICE_AREA="Inner West and Eastern Suburbs, Sydney"
TRADIE_MOBILE=+61400000000          # where alerts go (E.164)
TRADIE_EMAIL=

# --- App ---
PORT=3000
PUBLIC_URL=https://jobs.example.com.au   # the address Twilio and your email provider will call
DASHBOARD_PASSWORD=change-me             # browser asks for any username + this password
DB_PATH=data/tradie.db

# --- AI triage (Anthropic). Without it, keyword rules are used. ---
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Phone + SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+61200000000      # your Twilio Australian number
# TWILIO_VALIDATE_SIGNATURES=false   # only for local testing

# --- Email screening ---
EMAIL_INBOUND_KEY=some-long-random-string   # add ?key=... to the inbound webhook URL
SENDGRID_API_KEY=                           # optional: auto-reply to customers
EMAIL_FROM=jobs@example.com.au

# --- Optional free push notifications (install the ntfy app and subscribe to this topic) ---
NTFY_TOPIC=
